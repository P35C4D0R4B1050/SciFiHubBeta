@model IEnumerable<SciFiHub.Web.DTOs.Libro.LibroCardDTO>

@{
    ViewData["Title"] = "Ofertas Especiales";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="jumbotron bg-danger bg-opacity-10 p-4 rounded">
            <h1 class="display-5">
                <i class="bi bi-tag-fill text-danger"></i> Ofertas Especiales
            </h1>
            <p class="lead">Los mejores descuentos en ciencia ficción y fantasía</p>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="row mb-3">
        <div class="col-12">
            <p class="text-muted">Mostrando @Model.Count() libro(s) en oferta</p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var libro in Model)
        {
            <div class="col">
                <partial name="_LibroCard" model="libro" />
            </div>
        }
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle fs-1"></i>
                <h4 class="mt-3">No hay ofertas disponibles en este momento</h4>
                <p>Revisa nuestro catálogo completo o vuelve pronto para ver nuevas promociones.</p>
                <a asp-controller="Catalogo" asp-action="Index" class="btn btn-primary mt-3">
                    <i class="bi bi-book"></i> Ver Catálogo Completo
                </a>
            </div>
        </div>
    </div>
}
