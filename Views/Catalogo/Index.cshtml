@model SciFiHub.Web.DTOs.Common.PagedResult<SciFiHub.Web.DTOs.Libro.LibroCardDTO>

@{
    ViewData["Title"] = "Catálogo de Libros";
    var categorias = ViewBag.Categorias as IEnumerable<SciFiHub.Web.DTOs.Categoria.CategoriaDTO> ?? Enumerable.Empty<SciFiHub.Web.DTOs.Categoria.CategoriaDTO>();
    var filtro = ViewBag.FiltroActual as SciFiHub.Web.DTOs.Libro.LibrosFiltroDTO;
}

<div class="row">
    <!-- Sidebar de filtros -->
    <div class="col-md-3 mb-4">
        <div class="card sticky-top" style="top: 80px;">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtros</h5>
            </div>
            <div class="card-body">
                <form asp-action="Index" method="get" id="filtro-form">
                    <!-- Búsqueda -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Buscar</label>
                        <input type="text" name="TextoBusqueda" class="form-control" 
                               value="@filtro?.TextoBusqueda" placeholder="Título, autor...">
                    </div>
                    
                    <!-- Categoría -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Categoría</label>
                        <select name="CategoriaId" class="form-select">
                            <option value="">Todas las categorías</option>
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat.Id" selected="@(cat.Id == filtro?.CategoriaId)">
                                    @cat.Nombre
                                </option>
                            }
                        </select>
                    </div>
                    
                    <!-- Rango de precio -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Rango de Precio</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" name="PrecioMin" class="form-control" 
                                       value="@filtro?.PrecioMin" placeholder="Min" min="0" step="0.01">
                            </div>
                            <div class="col-6">
                                <input type="number" name="PrecioMax" class="form-control" 
                                       value="@filtro?.PrecioMax" placeholder="Max" min="0" step="0.01">
                            </div>
                        </div>
                    </div>
                    
                    <!-- Destacados -->
                    <div class="mb-3 form-check">
                        <input type="checkbox" name="Destacado" class="form-check-input" 
                               checked="@(filtro?.Destacado ?? false)" value="true">
                        <label class="form-check-label">
                            Solo destacados
                        </label>
                    </div>
                    
                    <!-- Disponibles -->
                    <div class="mb-3 form-check">
                        <input type="checkbox" id="soloDisponibles" name="SoloDisponibles" class="form-check-input" 
                               checked="@(filtro?.SoloDisponibles ?? true)" value="true">
                        <label class="form-check-label" for="soloDisponibles">
                            Solo disponibles
                        </label>
                    </div>
                    
                    <!-- Ordenar por -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ordenar por</label>
                        <select name="OrdenarPor" class="form-select">
                            <option value="">Relevancia</option>
                            <option value="titulo" selected="@(filtro?.OrdenarPor == "titulo")">Título</option>
                            <option value="autor" selected="@(filtro?.OrdenarPor == "autor")">Autor</option>
                            <option value="precio" selected="@(filtro?.OrdenarPor == "precio")">Precio</option>
                            <option value="fecha" selected="@(filtro?.OrdenarPor == "fecha")">Más recientes</option>
                        </select>
                    </div>
                    
                    <input type="hidden" name="PageNumber" value="1">
                    <input type="hidden" name="PageSize" value="@(filtro?.PageSize ?? 12)">
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Aplicar Filtros
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Limpiar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Listado de libros -->
    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-book"></i> Catálogo de Libros</h2>
            <div class="text-muted">
                Mostrando @Model.Items.Count() de @Model.TotalCount resultados
            </div>
        </div>
        
        @if (Model.Items.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                @foreach (var libro in Model.Items)
                {
                    <div class="col">
                        <partial name="_LibroCard" model="libro" />
                    </div>
                }
            </div>
            
            <!-- Paginación -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Navegación de páginas">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-route-PageNumber="@(Model.PageNumber - 1)" 
                               asp-route-TextoBusqueda="@filtro?.TextoBusqueda"
                               asp-route-CategoriaId="@filtro?.CategoriaId"
                               asp-route-PrecioMin="@filtro?.PrecioMin"
                               asp-route-PrecioMax="@filtro?.PrecioMax"
                               asp-route-Destacado="@filtro?.Destacado"
                               asp-route-SoloDisponibles="@filtro?.SoloDisponibles"
                               asp-route-OrdenarPor="@filtro?.OrdenarPor">
                                <i class="bi bi-chevron-left"></i> Anterior
                            </a>
                        </li>
                        
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-route-PageNumber="@i"
                                   asp-route-TextoBusqueda="@filtro?.TextoBusqueda"
                                   asp-route-CategoriaId="@filtro?.CategoriaId"
                                   asp-route-PrecioMin="@filtro?.PrecioMin"
                                   asp-route-PrecioMax="@filtro?.PrecioMax"
                                   asp-route-Destacado="@filtro?.Destacado"
                                   asp-route-SoloDisponibles="@filtro?.SoloDisponibles"
                                   asp-route-OrdenarPor="@filtro?.OrdenarPor">
                                    @i
                                </a>
                            </li>
                        }
                        
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-route-PageNumber="@(Model.PageNumber + 1)"
                               asp-route-TextoBusqueda="@filtro?.TextoBusqueda"
                               asp-route-CategoriaId="@filtro?.CategoriaId"
                               asp-route-PrecioMin="@filtro?.PrecioMin"
                               asp-route-PrecioMax="@filtro?.PrecioMax"
                               asp-route-Destacado="@filtro?.Destacado"
                               asp-route-SoloDisponibles="@filtro?.SoloDisponibles"
                               asp-route-OrdenarPor="@filtro?.OrdenarPor">
                                Siguiente <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle fs-1"></i>
                <h4 class="mt-3">No se encontraron libros</h4>
                <p>Intenta ajustar los filtros o buscar con otros términos.</p>
                <a asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-arrow-clockwise"></i> Ver todo el catálogo
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/catalogo.js" asp-append-version="true"></script>
}
