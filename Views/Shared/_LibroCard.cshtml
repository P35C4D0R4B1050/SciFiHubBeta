@model SciFiHub.Web.DTOs.Libro.LibroCardDTO

<div class="card h-100 libro-card">
    @if (Model.TieneOferta)
    {
        <div class="position-absolute top-0 end-0 m-2">
            <span class="badge bg-danger">
                -@Model.PorcentajeDescuento%
            </span>
        </div>
    }
    @if (Model.Destacado)
    {
        <div class="position-absolute top-0 start-0 m-2">
            <span class="badge bg-warning text-dark">
                <i class="bi bi-star-fill"></i> Destacado
            </span>
        </div>
    }
    
    <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@Model.Id" class="text-decoration-none">
        @if (!string.IsNullOrEmpty(Model.ImagenPortada))
        {
            <img src="@Model.ImagenPortada" class="card-img-top libro-img" alt="@Model.Titulo">
        }
        else
        {
            <div class="card-img-top libro-img-placeholder bg-light d-flex align-items-center justify-content-center">
                <i class="bi bi-book text-secondary" style="font-size: 4rem;"></i>
            </div>
        }
    </a>
    
    <div class="card-body d-flex flex-column">
        <span class="badge bg-secondary mb-2 align-self-start">@Model.CategoriaNombre</span>
        
        <h6 class="card-title text-truncate" title="@Model.Titulo">
            <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@Model.Id" class="text-dark text-decoration-none">
                @Model.Titulo
            </a>
        </h6>
        
        <p class="card-text text-muted small mb-2">
            <i class="bi bi-person"></i> @Model.Autor
        </p>
        
        <div class="mt-auto">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    @if (Model.TieneOferta)
                    {
                        <span class="text-muted text-decoration-line-through small">$@Model.Precio.ToString("N2")</span>
                        <span class="text-danger fw-bold fs-5">$@Model.PrecioFinal.ToString("N2")</span>
                    }
                    else
                    {
                        <span class="text-primary fw-bold fs-5">$@Model.PrecioFinal.ToString("N2")</span>
                    }
                </div>
                
                @if (Model.Disponible)
                {
                    <span class="badge bg-success">
                        <i class="bi bi-check-circle"></i> Disponible
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        <i class="bi bi-x-circle"></i> Agotado
                    </span>
                }
            </div>
            
            @if (Model.Disponible)
            {
                @if (!User.IsInRole("Administrador") && !User.IsInRole("Vendedor"))
                {
                    <div class="d-grid gap-2">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <button type="button" class="btn btn-primary btn-sm btn-add-carrito" 
                                    data-libro-id="@Model.Id" data-libro-titulo="@Model.Titulo">
                                <i class="bi bi-cart-plus"></i> Agregar al Carrito
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión para comprar
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="d-grid gap-2">
                        <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@Model.Id" 
                           class="btn btn-outline-info btn-sm">
                            <i class="bi bi-eye"></i> Ver Detalles
                        </a>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .libro-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .libro-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    .libro-img {
        height: 300px;
        object-fit: cover;
    }
    .libro-img-placeholder {
        height: 300px;
    }
</style>
