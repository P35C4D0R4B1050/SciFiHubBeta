@model SciFiHub.Web.DTOs.Carrito.CarritoDTO

@{
    ViewData["Title"] = "Mi Carrito";
}

<div class="row">
    <div class="col-12">
        <h2><i class="bi bi-cart3"></i> Mi Carrito de Compras</h2>
        <hr>
    </div>
</div>

@if (Model.TieneItems)
{
    <div class="row">
        <!-- Items del carrito -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-bag"></i> Items en tu carrito (@Model.CantidadItems)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Libro</th>
                                    <th class="text-center">Precio</th>
                                    <th class="text-center" style="width: 150px;">Cantidad</th>
                                    <th class="text-center">Subtotal</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr data-libro-id="@item.LibroId">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.ImagenPortada))
                                                {
                                                    <img src="@item.ImagenPortada" alt="@item.Titulo" 
                                                         class="img-thumbnail me-3" style="width: 80px; height: 100px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light me-3 d-flex align-items-center justify-content-center" 
                                                         style="width: 80px; height: 100px;">
                                                        <i class="bi bi-book text-secondary"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <h6 class="mb-1">@item.Titulo</h6>
                                                    <small class="text-muted">@item.Autor</small>
                                                    @if (!item.TieneStockSuficiente)
                                                    {
                                                        <br>
                                                        <span class="badge bg-danger">
                                                            <i class="bi bi-exclamation-triangle"></i> Stock insuficiente (Disponible: @item.StockDisponible)
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center align-middle">
                                            <strong>$@item.PrecioUnitario.ToString("N2")</strong>
                                        </td>
                                        <td class="text-center align-middle">
                                            <div class="input-group input-group-sm">
                                                <button class="btn btn-outline-secondary btn-cantidad-menos" type="button" data-libro-id="@item.LibroId">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <input type="number" class="form-control text-center cantidad-input" 
                                                       value="@item.Cantidad" min="1" max="@item.StockDisponible" 
                                                       data-libro-id="@item.LibroId" readonly>
                                                <button class="btn btn-outline-secondary btn-cantidad-mas" type="button" 
                                                        data-libro-id="@item.LibroId" data-max="@item.StockDisponible">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="text-center align-middle">
                                            <strong class="text-primary">$@item.Subtotal.ToString("N2")</strong>
                                        </td>
                                        <td class="text-center align-middle">
                                            <button type="button" class="btn btn-danger btn-sm btn-eliminar-item" 
                                                    data-libro-id="@item.LibroId" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <form asp-action="Limpiar" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('¿Estás seguro de vaciar el carrito?')">
                            <i class="bi bi-trash"></i> Vaciar Carrito
                        </button>
                    </form>
                    <a asp-controller="Catalogo" asp-action="Index" class="btn btn-outline-primary float-end">
                        <i class="bi bi-arrow-left"></i> Seguir Comprando
                    </a>
                </div>
            </div>
        </div>

        <!-- Resumen del pedido -->
        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 80px;">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-calculator"></i> Resumen del Pedido</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <strong id="resumen-subtotal">$@Model.Subtotal.ToString("N2")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>IGV (18%):</span>
                        <strong id="resumen-igv">$@Model.IGV.ToString("N2")</strong>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                        <h5 class="mb-0">Total:</h5>
                        <h5 class="mb-0 text-success" id="resumen-total">$@Model.Total.ToString("N2")</h5>
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        <strong>@Model.CantidadItems</strong> item(s) en tu carrito
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="Checkout" class="btn btn-success btn-lg">
                            <i class="bi bi-credit-card"></i> Proceder al Pago
                        </a>
                    </div>
                </div>
            </div>

            <!-- Información adicional -->
            <div class="card mt-3">
                <div class="card-body">
                    <h6><i class="bi bi-shield-check"></i> Compra Segura</h6>
                    <small class="text-muted">
                        Tu información está protegida y segura.
                    </small>
                    <hr>
                    <h6><i class="bi bi-truck"></i> Envío a Domicilio</h6>
                    <small class="text-muted">
                        Entrega en 3-5 días hábiles.
                    </small>
                    <hr>
                    <h6><i class="bi bi-arrow-return-left"></i> Devolución Fácil</h6>
                    <small class="text-muted">
                        30 días para devolver tu compra.
                    </small>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Carrito vacío -->
    <div class="row">
        <div class="col-12">
            <div class="text-center py-5">
                <i class="bi bi-cart-x text-muted" style="font-size: 5rem;"></i>
                <h3 class="mt-3">Tu carrito está vacío</h3>
                <p class="text-muted">Explora nuestro catálogo y agrega libros increíbles.</p>
                <a asp-controller="Catalogo" asp-action="Index" class="btn btn-primary btn-lg mt-3">
                    <i class="bi bi-book"></i> Explorar Catálogo
                </a>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Incrementar cantidad
            $('.btn-cantidad-mas').click(function() {
                const libroId = $(this).data('libro-id');
                const max = parseInt($(this).data('max'));
                const $input = $(`.cantidad-input[data-libro-id="${libroId}"]`);
                let cantidad = parseInt($input.val());
                
                if (cantidad < max) {
                    cantidad++;
                    actualizarCantidad(libroId, cantidad);
                } else {
                    showToast('No hay más stock disponible', 'warning');
                }
            });

            // Decrementar cantidad
            $('.btn-cantidad-menos').click(function() {
                const libroId = $(this).data('libro-id');
                const $input = $(`.cantidad-input[data-libro-id="${libroId}"]`);
                let cantidad = parseInt($input.val());
                
                if (cantidad > 1) {
                    cantidad--;
                    actualizarCantidad(libroId, cantidad);
                }
            });

            // Función para actualizar cantidad
            function actualizarCantidad(libroId, nuevaCantidad) {
                $.ajax({
                    url: '@Url.Action("ActualizarCantidad", "Carrito")',
                    type: 'POST',
                    data: {
                        LibroId: libroId,
                        NuevaCantidad: nuevaCantidad,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            // Actualizar la UI
                            $(`.cantidad-input[data-libro-id="${libroId}"]`).val(nuevaCantidad);
                            $('#resumen-subtotal').text('$' + response.data.subtotal.toFixed(2));
                            $('#resumen-igv').text('$' + response.data.igv.toFixed(2));
                            $('#resumen-total').text('$' + response.data.total.toFixed(2));
                            $('#carrito-badge').text(response.data.cantidadItems);
                            
                            // Recalcular subtotal del item
                            const $row = $(`tr[data-libro-id="${libroId}"]`);
                            const precio = parseFloat($row.find('td:eq(1) strong').text().replace('$', ''));
                            const subtotal = precio * nuevaCantidad;
                            $row.find('td:eq(3) strong').text('$' + subtotal.toFixed(2));
                            
                            showToast(response.message || 'Cantidad actualizada', 'success');
                        } else {
                            showToast(response.message || 'Error al actualizar', 'danger');
                        }
                    },
                    error: function() {
                        showToast('Error de conexión', 'danger');
                    }
                });
            }
        });
    </script>
}
