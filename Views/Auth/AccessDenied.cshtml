@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow">
            <div class="card-body p-5">
                <i class="bi bi-shield-lock text-danger" style="font-size: 5rem;"></i>
                <h1 class="text-danger mt-3">Acceso Denegado</h1>
                <p class="lead">No tienes permisos para acceder a este recurso.</p>
                <hr>
                <p>Si crees que esto es un error, contacta al administrador del sistema.</p>
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house"></i> Volver al Inicio
                    </a>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-secondary">
                        <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
