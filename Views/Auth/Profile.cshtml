@model SciFiHub.Web.DTOs.Usuario.UsuarioDTO

@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Header -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-circle me-2"></i>Mi Perfil
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 text-center mb-4">
                            <div class="avatar-large">
                                <i class="bi bi-person-circle display-1 text-primary"></i>
                            </div>
                            <h3 class="mt-3">@Model.NombreCompleto</h3>
                            <span class="badge bg-@(Model.Rol == SciFiHub.Domain.Enums.RolUsuario.Administrador ? "danger" : Model.Rol == SciFiHub.Domain.Enums.RolUsuario.Vendedor ? "primary" : "success") fs-6">
                                @Model.Rol.ToString()
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información Personal -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información Personal</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Nombre Completo</label>
                            <p class="fw-bold">@Model.NombreCompleto</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Username</label>
                            <p class="fw-bold">
                                <i class="bi bi-person-badge text-primary me-2"></i>@Model.Username
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Email</label>
                            <p class="fw-bold">
                                <i class="bi bi-envelope text-info me-2"></i>@Model.Email
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Teléfono</label>
                            <p class="fw-bold">
                                @if (!string.IsNullOrEmpty(Model.Telefono))
                                {
                                    <i class="bi bi-telephone text-success me-2"></i>@Model.Telefono
                                }
                                else
                                {
                                    <span class="text-muted">No especificado</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Estado de Cuenta</label>
                            <p>
                                <span class="badge bg-@(Model.Estado == SciFiHub.Domain.Enums.EstadoUsuario.Activo ? "success" : "secondary")">
                                    @Model.Estado.ToString()
                                </span>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Fecha de Registro</label>
                            <p class="fw-bold">
                                <i class="bi bi-calendar text-warning me-2"></i>
                                @Model.FechaRegistro.ToString("dd/MM/yyyy")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Acciones -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Acciones de Cuenta</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="ChangePassword" class="btn btn-outline-primary btn-lg">
                            <i class="bi bi-key me-2"></i>Cambiar Contraseña
                        </a>
                        
                        @if (Model.Rol == SciFiHub.Domain.Enums.RolUsuario.Administrador)
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-danger">
                                <i class="bi bi-speedometer2 me-2"></i>Ir al Dashboard
                            </a>
                        }
                        else if (Model.Rol == SciFiHub.Domain.Enums.RolUsuario.Vendedor)
                        {
                            <a asp-controller="Vendedor" asp-action="Inventario" class="btn btn-outline-primary">
                                <i class="bi bi-box-seam me-2"></i>Ir a Inventario
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Catalogo" asp-action="Index" class="btn btn-outline-success">
                                <i class="bi bi-shop me-2"></i>Ir al Catálogo
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .avatar-large {
            width: 120px;
            height: 120px;
            margin: 0 auto;
        }
        
        .card {
            border-radius: 10px;
        }
        
        .card-header {
            border-radius: 10px 10px 0 0 !important;
        }
    </style>
}
