@{
    ViewData["Title"] = "Acerca de SciFiHub";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="display-4"><i class="bi bi-info-circle"></i> Acerca de SciFiHub</h1>
        <hr>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <h2>Nuestra Historia</h2>
        <p class="lead">
            SciFiHub es tu librería especializada en ciencia ficción y fantasía, 
            dedicada a traerte los mejores títulos del género.
        </p>

        <p>
            Desde nuestra fundación en 2025, hemos trabajado incansablemente para crear 
            una comunidad de lectores apasionados por las historias que desafían la imaginación.
        </p>

        <h3 class="mt-4">Nuestra Misión</h3>
        <p>
            Proporcionar acceso fácil y rápido a los mejores libros de ciencia ficción y fantasía, 
            conectando a los lectores con mundos extraordinarios y autores talentosos.
        </p>

        <h3 class="mt-4">Por qué elegirnos</h3>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">
                <i class="bi bi-check-circle text-success"></i> 
                <strong>Catálogo especializado</strong> - Solo los mejores títulos de CF y Fantasía
            </li>
            <li class="list-group-item">
                <i class="bi bi-check-circle text-success"></i> 
                <strong>Envío rápido</strong> - Entrega en 3-5 días hábiles
            </li>
            <li class="list-group-item">
                <i class="bi bi-check-circle text-success"></i> 
                <strong>Precios competitivos</strong> - Ofertas y descuentos frecuentes
            </li>
            <li class="list-group-item">
                <i class="bi bi-check-circle text-success"></i> 
                <strong>Atención personalizada</strong> - Equipo experto y apasionado
            </li>
        </ul>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Información de Contacto</h5>
            </div>
            <div class="card-body">
                <p><i class="bi bi-envelope"></i> <strong>Email:</strong><br>
                info@scifihub.com</p>
                <p><i class="bi bi-telephone"></i> <strong>Teléfono:</strong><br>
                +1 234 567 8900</p>
                <p><i class="bi bi-clock"></i> <strong>Horario:</strong><br>
                Lun-Vie: 9:00 - 18:00<br>
                Sáb: 10:00 - 14:00</p>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Síguenos</h5>
            </div>
            <div class="card-body text-center">
                <a href="#" class="btn btn-outline-primary btn-sm me-2">
                    <i class="bi bi-facebook"></i> Facebook
                </a>
                <a href="#" class="btn btn-outline-info btn-sm me-2">
                    <i class="bi bi-twitter"></i> Twitter
                </a>
                <a href="#" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-instagram"></i> Instagram
                </a>
            </div>
        </div>
    </div>
</div>
